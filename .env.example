# Database Configuration (PostgreSQL)
POSTGRES_URL=postgres://username:password@host:port/database?sslmode=require
POSTGRES_DATABASE=your_database_name
POSTGRES_HOST=your_postgres_host
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_USER=your_postgres_username
POSTGRES_PRISMA_URL=postgres://username:password@host:port/database?pgbouncer=true&connect_timeout=15&sslmode=require
POSTGRES_URL_NO_SSL=postgres://username:password@host:port/database
POSTGRES_URL_NON_POOLING=postgres://username:password@non_pooling_host:port/database?sslmode=require

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Clerk Authentication Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk URL Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where signing in lands when nothing else was asked for. FALLBACK, not FORCE:
# the middleware protects a route by sending the visitor to sign in with the URL
# they wanted on the query string, and FORCE discards it. A QR code scanned on a
# phone that has never signed in is exactly that case -- it went to the project
# picker, having just been told which patient to open.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard